@model IList<CompanyListItemViewModel>
@{
    ViewBag.Title = "Companies";
}
@Html.Partial("_PageHeader")
<section class="section-padding">
    <div class="container">
        <div class="row">
            @foreach (var company in Model)
            {
                <div class="col-lg-4 col-sm-6">
                    <div class="jb-panel">
                        <div class="company-mark">
                            @if (!string.IsNullOrEmpty(company.LogoPath))
                            {
                                <img src="@Url.Content("~/" + company.LogoPath)" alt="@company.CompanyName" />
                            }
                            else
                            {
                                @(string.IsNullOrEmpty(company.CompanyName) ? "?" : company.CompanyName.Substring(0, 1))
                            }
                        </div>
                        <h4><a href="@Url.Action("Details", "Companies", new { id = company.Id })">@company.CompanyName</a></h4>
                        <p>@company.Industry</p>
                        <span class="jb-badge">@company.ActiveJobCount active jobs</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
